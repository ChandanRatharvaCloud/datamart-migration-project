					"# Construct the ADLS Gen2 path\n",
					"adls_path = \"abfss://adlsgen2@sadevenvdatamart.dfs.core.windows.net/bronze-zone\"\n",
					"\n",
					"# Read the CSV file into a DataFrame\n",
					"df1 = spark.read \\\n",
					"    .format(\"csv\") \\\n",
					"    .option(\"header\",\"true\") \\\n",
					"    .load(adls_path)\n",
					"\n",
					"# Show a sample of the data\n",
					"df1.show()\n",
					"display(df1)\n",
					"\n",
					"adls_path = \"abfss://adlsgen2@sadevenvdatamart.dfs.core.windows.net/silver-zone\"\n",
					"df1.write.format(\"parquet\").mode(\"overwrite\").save(adls_path)"
